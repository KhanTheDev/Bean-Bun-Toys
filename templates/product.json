    "reviews_bbt01": {
      "type": "section",
      "name": "t:names.section",
      "blocks": {
        "rv_html": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "<style>\n  .reviews-section { max-width: 900px; margin: 0 auto; text-align: center; padding: 8px 16px; }\n  .reviews-heading { font-family: var(--font-heading--family); font-size: 1.75rem; margin: 0 0 20px 0; }\n  .reviews-summary { display: flex; flex-direction: column; align-items: center; gap: 6px; margin-bottom: 28px; }\n  .reviews-score { font-family: var(--font-heading--family); font-size: 2.5rem; color: #2E1A3D; line-height: 1; }\n  .reviews-stars { display: flex; justify-content: center; gap: 4px; color: #E8A93D; }\n  .reviews-stars svg { width: 22px; height: 22px; }\n  .reviews-count { font-family: var(--font-body--family); color: #6B5A7A; font-size: 0.9rem; margin: 4px 0 0 0; }\n  .reviews-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; text-align: left; }\n  .review-card { background: #FAF6FF; border-radius: 16px; padding: 18px 20px; display: flex; flex-direction: column; gap: 8px; }\n  .review-card__head { display: flex; align-items: center; gap: 10px; }\n  .review-card__avatar { width: 38px; height: 38px; border-radius: 50%; background: #EDE3F7; color: #6B3FA0; font-family: var(--font-body--family); font-weight: 700; font-size: 0.85rem; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n  .review-card__name { font-family: var(--font-body--family); font-weight: 600; font-size: 0.95rem; color: #2E1A3D; display: block; }\n  .review-card__sub { display: flex; align-items: center; gap: 6px; margin-top: 2px; }\n  .review-card__sub-stars { color: #E8A93D; font-size: 0.8rem; letter-spacing: 1px; }\n  .review-card__time { font-family: var(--font-body--family); font-size: 0.75rem; color: #8A7A99; }\n  .review-card__text { font-family: var(--font-body--family); font-size: 0.9rem; color: #4A3A5A; line-height: 1.5; margin: 0; }\n  .reviews-source { font-family: var(--font-body--family); font-size: 0.8rem; color: #8A7A99; margin-top: 24px; }\n  .review-card__photo { width: 100%; border-radius: 12px; margin-top: 4px; display: block; object-fit: cover; }\n  @media screen and (max-width: 749px) {\n    .reviews-grid { grid-template-columns: 1fr; }\n  }\n</style>\n<div class=\"reviews-section\">\n  <h3 class=\"reviews-heading\">Reviews</h3>\n  <div class=\"reviews-summary\">\n    <span class=\"reviews-score\">5.0</span>\n    <div class=\"reviews-stars\">\n      {% for i in (1..5) %}\n        <svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 2.5l2.9 6.3 6.9.7-5.1 4.8 1.4 6.8L12 17.8 5.9 21.1l1.4-6.8-5.1-4.8 6.9-.7L12 2.5z\"/></svg>\n      {% endfor %}\n    </div>\n    <p class=\"reviews-count\">5 out of 5 · Based on 568 reviews on Facebook</p>\n  </div>\n  <div class=\"reviews-grid\">\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">JM</span>\n        <div>\n          <span class=\"review-card__name\">Jessica M.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">2d</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">Okay this is actually sooo cute 😭 It's way softer than I expected and looks adorable in my room.</p>\n      <img class=\"review-card__photo\" src=\"https://cdn.shopify.com/s/files/1/0836/8010/0581/files/kevin-h-review-unboxing.png?v=1787258662\" alt=\"Customer photo from Jessica M. review - Aubie eggplant bean bag chair unboxed\" loading=\"lazy\">\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">KH</span>\n        <div>\n          <span class=\"review-card__name\">Kevin H.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">It's such a cute little addition to my room. The shape and face are even better in person.</p>\n      <img class=\"review-card__photo\" src=\"https://cdn.shopify.com/s/files/1/0836/8010/0581/files/amanda-r-review-dog.png?v=1787259207\" alt=\"Customer photo from Kevin H. review - dog sitting in the Aubie eggplant bean bag chair\" loading=\"lazy\">\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">AR</span>\n        <div>\n          <span class=\"review-card__name\">Amanda R.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1w</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">My daughter is obsessed with it lol. She carries this thing around the house everywhere.</p>\n      <img class=\"review-card__photo\" src=\"https://cdn.shopify.com/s/files/1/0836/8010/0581/files/jessica-m-review-reading.webp?v=1787258662\" alt=\"Customer photo from Amanda R. review - toddler reading a book in the Aubie eggplant bean bag chair\" loading=\"lazy\">\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">ND</span>\n        <div>\n          <span class=\"review-card__name\">Nicole D.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">I saw the eggplant and had to get it 😄 No regrets. It's ridiculously soft.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">BT</span>\n        <div>\n          <span class=\"review-card__name\">Brian T.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1w</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">Super soft and squishy! Honestly even cuter in person.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">SG</span>\n        <div>\n          <span class=\"review-card__name\">Stephanie G.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">Actually really nice quality. It feels super plush and doesn't feel cheap at all.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">LK</span>\n        <div>\n          <span class=\"review-card__name\">Lauren K.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">2w</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">I bought it as a gift but now I kinda want one for myself 😅</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">MJ</span>\n        <div>\n          <span class=\"review-card__name\">Matt J.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">My kids fight over who gets to sit with it 😄 Guess I'm ordering another one.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">TP</span>\n        <div>\n          <span class=\"review-card__name\">Tyler P.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">2w</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">The eggplant design is hilarious and adorable at the same time. 10/10.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">HB</span>\n        <div>\n          <span class=\"review-card__name\">Hannah B.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">I loveeee this thing. Cute, soft, squishy and just weird enough to make me smile every time I see it.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">RS</span>\n        <div>\n          <span class=\"review-card__name\">Rachel S.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">3w</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">SO COMFY. I use it as a little pillow when I'm on the couch and it's perfect.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">CV</span>\n        <div>\n          <span class=\"review-card__name\">Chris V.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">Bought this for my friend as a funny gift and she genuinely loves it. Huge win lol.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">ML</span>\n        <div>\n          <span class=\"review-card__name\">Megan L.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">3w</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">Wasn't expecting it to be this soft. You literally just wanna keep squishing it.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">EF</span>\n        <div>\n          <span class=\"review-card__name\">Emily F.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">Probably one of the cutest things I've bought online 😄 It's so soft and the eggplant shape is perfect.</p>\n    </div>\n    <div class=\"review-card\">\n      <div class=\"review-card__head\">\n        <span class=\"review-card__avatar\">DW</span>\n        <div>\n          <span class=\"review-card__name\">Danielle W.</span>\n          <div class=\"review-card__sub\"><span class=\"review-card__sub-stars\">★★★★★</span><span class=\"review-card__time\">1mo</span></div>\n        </div>\n      </div>\n      <p class=\"review-card__text\">My niece opened it and immediately hugged it 😭 definitely a successful gift.</p>\n    </div>\n  </div>\n  <p class=\"reviews-source\">Reviews shared from the Bean Bun Toys Facebook page.</p>\n</div>"
