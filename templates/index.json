        "bp_html": {
          "type": "custom-liquid",
          "name": "t:names.custom_liquid",
          "settings": {
            "custom_liquid": "{%- liquid\n  assign product = all_products['aubie-the-eggplant-nook']\n-%}\n<style>\n  .bean-pals-heading {\n    font-family: var(--font-heading--family);\n    font-size: 2rem;\n    margin: 0 0 16px 0;\n  }\n  .bean-pals-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px;\n  }\n  .bean-pals-card {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    text-decoration: none;\n    color: inherit;\n  }\n  .bean-pals-card__box {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border-radius: 4px;\n    overflow: hidden;\n    background: #EDE3F7;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .bean-pals-card__box img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .bean-pals-card__label {\n    font-family: var(--font-body--family);\n    font-size: 1rem;\n    text-align: left;\n  }\n  .bean-pals-card__price {\n    font-family: var(--font-body--family);\n    font-size: 1rem;\n    text-align: left;\n  }\n\n  .cs-card {\n    position: relative;\n    aspect-ratio: 1 / 1;\n    width: 100%;\n    border-radius: 16px;\n    background: linear-gradient(160deg, #F4EDFA 0%, #DCC5EF 100%);\n    box-shadow: 0 8px 20px rgba(107, 63, 160, 0.12);\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: flex-end;\n    text-align: center;\n    padding: 16px 12px;\n    overflow: hidden;\n  }\n  .cs-card__art {\n    position: absolute;\n    inset: 0;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  .cs-card__content {\n    position: relative;\n    z-index: 2;\n  }\n  .cs-card__title {\n    font-family: var(--font-heading--family);\n    font-size: 1.15rem;\n    color: #2E1A3D;\n    margin: 0;\n  }\n  .cs-card__subtitle {\n    font-family: var(--font-body--family);\n    font-size: 0.8rem;\n    color: #6B5A7A;\n    margin: 4px 0 8px 0;\n  }\n  .cs-card__heart {\n    width: 18px;\n    height: 18px;\n    color: #B79FD6;\n  }\n  .cs-sparkle {\n    position: absolute;\n    color: #C9AEE8;\n    opacity: 0.9;\n  }\n  @media screen and (max-width: 749px) {\n    .bean-pals-grid {\n      grid-template-columns: repeat(2, 1fr);\n      row-gap: 24px;\n    }\n  }\n</style>\n<h3 class=\"bean-pals-heading\">Bean Pals</h3>\n<div class=\"bean-pals-grid\">\n  <a href=\"{{ product.url }}\" class=\"bean-pals-card\">\n    <div class=\"bean-pals-card__box\">\n      <img src=\"{{ product.featured_image | image_url: width: 600 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\">\n    </div>\n    <span class=\"bean-pals-card__label\">{{ product.title }}</span>\n    <span class=\"bean-pals-card__price\">{{ product.price | money }}</span>\n  </a>\n\n  <div class=\"bean-pals-card\">\n    <div class=\"cs-card\">\n      <svg class=\"cs-sparkle\" style=\"top:14px;left:14px;width:14px;height:14px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <svg class=\"cs-sparkle\" style=\"top:22px;right:16px;width:10px;height:10px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <svg class=\"cs-sparkle\" style=\"bottom:60px;right:10px;width:9px;height:9px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <div class=\"cs-card__art\">\n        <svg width=\"55%\" viewBox=\"0 0 120 100\" fill=\"none\">\n          <ellipse cx=\"60\" cy=\"90\" rx=\"42\" ry=\"7\" fill=\"#B79FD6\" opacity=\"0.35\"/>\n          <path d=\"M20 78 C18 45 35 20 60 20 C85 20 102 45 100 78 C100 82 96 85 90 83 C84 81 78 87 70 85 C64 83 60 88 54 85 C46 82 42 87 34 84 C26 81 20 82 20 78 Z\" fill=\"#B79FD6\"/>\n          <path d=\"M20 78 C18 45 35 20 60 20 C85 20 102 45 100 78\" stroke=\"#8F72B8\" stroke-width=\"2\" fill=\"none\" stroke-linecap=\"round\"/>\n        </svg>\n      </div>\n      <div class=\"cs-card__content\">\n        <p class=\"cs-card__title\">Coming Soon!</p>\n        <p class=\"cs-card__subtitle\">Something adorable<br>is on the way...</p>\n        <svg class=\"cs-card__heart\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"margin: 0 auto;\"><path d=\"M12 21s-7.5-4.6-10-9.1C.5 8.6 2.3 5 6 5c2.1 0 3.6 1.1 4.5 2.4.5.7.5 1.6 0 2.3C10.6 8.4 9.9 7 8 7c-2.3 0-3.5 1.9-3 4.1C6.2 15.1 12 19 12 19s5.8-3.9 7-7.9c.5-2.2-.7-4.1-3-4.1-1.9 0-2.6 1.4-2.5 2.7-.5-.7-.5-1.6 0-2.3C14.4 6.1 15.9 5 18 5c3.7 0 5.5 3.6 4 6.9C19.5 16.4 12 21 12 21Z\"/></svg>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"bean-pals-card\">\n    <div class=\"cs-card\">\n      <svg class=\"cs-sparkle\" style=\"top:14px;left:14px;width:14px;height:14px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <svg class=\"cs-sparkle\" style=\"top:20px;right:14px;width:10px;height:10px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <svg class=\"cs-sparkle\" style=\"bottom:58px;left:12px;width:9px;height:9px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <div class=\"cs-card__art\">\n        <svg width=\"55%\" viewBox=\"0 0 120 110\" fill=\"none\">\n          <ellipse cx=\"60\" cy=\"98\" rx=\"40\" ry=\"7\" fill=\"#8F72B8\" opacity=\"0.3\"/>\n          <path d=\"M60 8 C65 8 66 18 62 22\" stroke=\"#8F72B8\" stroke-width=\"4\" stroke-linecap=\"round\" fill=\"none\"/>\n          <path d=\"M45 26 C50 15 70 15 75 26 C78 30 72 32 60 30 C48 32 42 30 45 26 Z\" fill=\"#8F72B8\"/>\n          <path d=\"M22 95 C15 55 30 24 60 24 C90 24 105 55 98 95 C96 104 24 104 22 95 Z\" fill=\"#9C7FC2\"/>\n        </svg>\n      </div>\n      <div class=\"cs-card__content\">\n        <p class=\"cs-card__title\">Coming Soon!</p>\n        <p class=\"cs-card__subtitle\">Something adorable<br>is on the way...</p>\n        <svg class=\"cs-card__heart\" viewBox=\"0 0 24 24\" fill=\"currentColor\" style=\"margin: 0 auto;\"><path d=\"M12 21s-7.5-4.6-10-9.1C.5 8.6 2.3 5 6 5c2.1 0 3.6 1.1 4.5 2.4.5.7.5 1.6 0 2.3C10.6 8.4 9.9 7 8 7c-2.3 0-3.5 1.9-3 4.1C6.2 15.1 12 19 12 19s5.8-3.9 7-7.9c.5-2.2-.7-4.1-3-4.1-1.9 0-2.6 1.4-2.5 2.7-.5-.7-.5-1.6 0-2.3C14.4 6.1 15.9 5 18 5c3.7 0 5.5 3.6 4 6.9C19.5 16.4 12 21 12 21Z\"/></svg>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"bean-pals-card\">\n    <div class=\"cs-card\">\n      <svg class=\"cs-sparkle\" style=\"top:14px;left:16px;width:14px;height:14px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <svg class=\"cs-sparkle\" style=\"top:26px;right:16px;width:10px;height:10px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <svg class=\"cs-sparkle\" style=\"bottom:56px;right:14px;width:9px;height:9px;\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M12 0 L14 10 L24 12 L14 14 L12 24 L10 14 L0 12 L10 10 Z\"/></svg>\n      <div class=\"cs-card__art\">\n        <svg width=\"45%\" viewBox=\"0 0 100 130\" fill=\"none\">\n          <ellipse cx=\"50\" cy=\"118\" rx=\"34\" ry=\"7\" fill=\"#8F72B8\" opacity=\"0.3\"/>\n          <ellipse cx=\"50\" cy=\"65\" rx=\"42\" ry=\"58\" fill=\"#B79FD6\"/>\n          <circle cx=\"34\" cy=\"40\" r=\"7\" fill=\"#9C7FC2\"/>\n          <circle cx=\"62\" cy=\"55\" r=\"9\" fill=\"#9C7FC2\"/>\n          <circle cx=\"42\" cy=\"75\" r=\"6\" fill=\"#9C7FC2\"/>\n          <circle cx=\"66\" cy=\"90\" r=\"7\" fill=\"#9C7FC2\"/>\n          <circle cx=\"30\" cy=\"95\" r=\"5\" fill=\"#9C7FC2\"/>\n        </svg>\n      </div>\n      <div class=\"cs-card__content\">\n        <p class=\"cs-card__title\">Coming Soon!</p>\n        <p class=\"cs-card__subtitle\">Something adorable<