          "settings": {
            "custom_liquid": "{%- liquid\n  assign product = all_products['aubie-the-eggplant-nook']\n-%}\n<style>\n  .bean-pals-heading {\n    font-family: var(--font-heading--family);\n    font-size: 2rem;\n    margin: 0 0 16px 0;\n    text-align: center;\n  }\n  .bean-pals-grid {\n    display: grid;\n    grid-template-columns: repeat(4, 1fr);\n    gap: 8px;\n  }\n  .bean-pals-card {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n    text-decoration: none;\n    color: inherit;\n  }\n  .bean-pals-card__box {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border-radius: 12px;\n    overflow: hidden;\n    background: #EDE3F7;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    transition: transform 0.25s ease, box-shadow 0.25s ease;\n  }\n  .bean-pals-card:hover .bean-pals-card__box {\n    transform: translateY(-4px);\n    box-shadow: 0 10px 20px rgba(107, 63, 160, 0.18);\n  }\n  .bean-pals-card__box img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .bean-pals-card__label {\n    font-family: var(--font-body--family);\n    font-size: 1rem;\n    text-align: left;\n  }\n  .bean-pals-card__price {\n    font-family: var(--font-accent--family);\n    font-size: 2rem;\n    font-weight: 700;\n    text-align: left;\n  }\n  .bean-pals-card__price s {\n    font-size: 1rem;\n    font-weight: 400;\n    color: #8A7A99;\n    margin-right: 6px;\n    text-decoration-color: #8A7A99;\n  }\n  .bean-pals-card__sale-price {\n    color: #6B3FA0;\n  }\n  .bean-pals-card__badge {\n    display: inline-block;\n    align-self: flex-start;\n    background: #6B3FA0;\n    color: #fff;\n    font-size: 0.7rem;\n    font-weight: 600;\n    padding: 2px 8px;\n    border-radius: 100px;\n    margin-bottom: -4px;\n  }\n\n  .cs-card {\n    display: flex;\n    flex-direction: column;\n    gap: 4px;\n  }\n  .cs-card__art {\n    aspect-ratio: 1 / 1;\n    width: 100%;\n    border-radius: 12px;\n    overflow: hidden;\n    box-shadow: 0 8px 20px rgba(107, 63, 160, 0.12);\n    transition: transform 0.25s ease, box-shadow 0.25s ease;\n  }\n  .cs-card:hover .cs-card__art {\n    transform: translateY(-4px);\n    box-shadow: 0 10px 22px rgba(107, 63, 160, 0.2);\n  }\n  .cs-card__art img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .cs-card__title {\n    font-family: var(--font-body--family);\n    font-size: 1rem;\n    color: #2E1A3D;\n    margin: 0;\n    text-align: center;\n  }\n  .cs-card__subtitle {\n    font-family: var(--font-body--family);\n    font-size: 0.85rem;\n    color: #6B5A7A;\n    margin: 0;\n    text-align: center;\n  }\n  @media screen and (max-width: 749px) {\n    .bean-pals-grid {\n      grid-template-columns: repeat(2, 1fr);\n      row-gap: 24px;\n    }\n  }\n</style>\n<h3 class=\"bean-pals-heading\">✦ Bean Pals ✦</h3>\n<div class=\"bean-pals-grid\">\n  <a href=\"{{ product.url }}\" class=\"bean-pals-card\">\n    <div class=\"bean-pals-card__box\">\n      <img src=\"{{ product.featured_image | image_url: width: 600 }}\" alt=\"{{ product.title | escape }}\" loading=\"lazy\">\n    </div>\n    <span class=\"bean-pals-card__label\">{{ product.title }}</span>\n    {%- if product.compare_at_price > product.price -%}\n      <span class=\"bean-pals-card__badge\">50% Off Sale</span>\n      <span class=\"bean-pals-card__price\"><s>{{ product.compare_at_price | money }}</s><span class=\"bean-pals-card__sale-price\">{{ product.price | money }}</span></span>\n    {%- else -%}\n      <span class=\"bean-pals-card__price\">{{ product.price | money }}</span>\n    {%- endif -%}\n  </a>\n\n  <div class=\"cs-card\">\n    <div class=\"cs-card__art\">\n      <img src=\"{{ 'cs-shroud-v3-graphic.png' | file_img_url: '800x' }}\" alt=\"Coming Soon - mystery plush\">\n    </div>\n    <p class=\"cs-card__title\">Coming Soon!</p>\n    <p class=\"cs-card__subtitle\">Something adorable is on the way...</p>\n  </div>\n\n  <div class=\"cs-card\">\n    <div class=\"cs-card__art\">\n      <img src=\"{{ 'cs-egg-v3-graphic.png' | file_img_url: '800x' }}\" alt=\"Coming Soon - polka dot plush egg\">\n    </div>\n    <p class=\"cs-card__title\">Coming Soon!</p>\n    <p class=\"cs-card__subtitle\">Something adorable is on the way...</p>\n  </div>\n\n  <div class=\"cs-card\">\n    <div class=\"cs-card__art\">\n      <img src=\"{{ 'cs-pear-v3-graphic.png' | file_img_url: '800x' }}\" alt=\"Coming Soon - mystery pear-shaped plush\">\n    </div>\n    <p class=\"cs-card__title\">Coming Soon!</p>\n    <p class=\"cs-card__subtitle\">Something adorable is on the way...</p>\n  </div>\n\n  <div class=\"cs-card\">\n    <div class=\"cs-card__art\">\n      <img src=\"{{ 'cs-shroud-v3-graphic.png' | file_img_url: '800x' }}\" alt=\"Coming Soon - pink mystery plush\" style=\"filter: hue-rotate(140deg) saturate(1.1);\">\n    </div>\n    <p class=\"cs-card__title\">Coming Soon!</p>\n    <p class=\"cs-card__subtitle\">Something adorable is on the way...</p>\n  </div>\n\n  <div class=\"cs-card\">\n    <div class=\"cs-card__art\">\n      <img src=\"{{ 'cs-shroud-v3-graphic.png' | file_img_url: '800x' }}\" alt=\"Coming Soon - blue mystery plush\" style=\"filter: hue-rotate(230deg) saturate(1.1);\">\n    </div>\n    <p class=\"cs-card__title\">Coming Soon!</p>\n    <p class=\"cs-card__subtitle\">Something adorable is on the way...</p>\n  </div>\n\n  <div class=\"cs-card\">\n    <div class=\"cs-card__art\">\n      <img src=\"{{ 'cs-shroud-v3-graphic.png' | file_img_url: '800x' }}\" alt=\"Coming Soon - yellow mystery plush\" style=\"filter: hue-rotate(60deg) saturate(1.3);\">\n    </div>\n    <p class=\"cs-card__title\">Coming Soon!</p>\n    <p class=\"cs-card__subtitle\">Something adorable is on the way...</p>\n  </div>\n\n  <div class=\"cs-card\">\n    <div class=\"cs-card__art\">\n      <img src=\"{{ 'cs-shroud-v3-graphic.png' | file_img_url: '800x' }}\" alt=\"Coming Soon - green mystery plush\" style=\"filter: hue-rotate(280deg) saturate(1.1) 